VITE_API_BASE=http://localhost:8000

# Fallback Deepgram credential, used only when the backend cannot mint a
# short-lived token. Minting requires a Deepgram key with token-grant
# permission; a key without it returns FORBIDDEN. The app prefers a minted
# token and falls back to this, so supplying a token-capable key upgrades it
# with no code change. See README, Known tradeoffs.
VITE_DEEPGRAM_KEY=
